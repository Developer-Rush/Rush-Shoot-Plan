# ---------------------------------------------------------------------------
# Rush Republic Employee Management Portal - backend environment
# Copy to .env and fill in real values:  cp .env.example .env
# ---------------------------------------------------------------------------

# Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=replace-with-a-50-char-random-string

# Never leave this True in production.
DEBUG=True

# Comma-separated hostnames Django will serve.
ALLOWED_HOSTS=localhost,127.0.0.1

# ---- PostgreSQL -------------------------------------------------------------
# Local dev: fill in DB_NAME/DB_USER/... below and leave DATABASE_URL blank.
# Deployed on Render: leave DB_* blank and set DATABASE_URL instead -- Render
# provides this automatically when you attach a Postgres instance to the
# backend service (it's the "Internal Database URL" on the database's page).
DATABASE_URL=

DB_NAME=rush_republic_final_db
DB_USER=rush_republic_user
DB_PASSWORD=replace-with-your-db-password
DB_HOST=127.0.0.1
DB_PORT=5432

# ---- CORS / CSRF ------------------------------------------------------------
# Comma-separated list of frontend origins allowed to call the API.
# Production example: https://rush-republic.vercel.app
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# Needed for the Django admin site (session/cookie-based) once served over
# HTTPS from a real domain. Usually the same value as CORS_ORIGIN above --
# only set this separately if the admin site is accessed from a different origin.
CSRF_TRUSTED_ORIGINS=

# ---- Media storage (Cloudinary) ---------------------------------------------
# Local dev: leave blank -- uploads are saved to backend/media/ on disk.
# Deployed on Render: set this (Render's disk is wiped on every deploy, so
# uploaded images need to live somewhere else). Get the value from your
# Cloudinary Dashboard -> "API Environment variable" -- it looks like:
#   cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=
